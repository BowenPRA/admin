# Copy to .env and fill in from Supabase > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Optional: lets the app save invoice emails (PDF attached) as Gmail drafts in admin@palmriveracademy.edu.vn. It never sends.
# Google Cloud > Google Auth Platform > Clients > Web application (scope gmail.compose). See README.
VITE_GOOGLE_CLIENT_ID=
VITE_GMAIL_SENDER=admin@palmriveracademy.edu.vn
