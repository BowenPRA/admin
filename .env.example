# Copy to .env and fill in from Supabase > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Optional: lets the Send button email invoices straight from admin@palmriveracademy.edu.vn.
# Google Cloud > APIs & Services > Credentials > OAuth client ID (Web application).
VITE_GOOGLE_CLIENT_ID=
VITE_GMAIL_SENDER=admin@palmriveracademy.edu.vn
